{
  // Python: a local virtualenv with requirements-dev.txt installed
  //   python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Tests import the analyzers from the package (`from aws_analyzer import s3`), with
  // tests/conftest.py putting src/ on sys.path. Pylance needs the same path to resolve
  // those imports.
  "python.analysis.extraPaths": ["src"],
  "python.analysis.typeCheckingMode": "basic",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Lint with the ruff pinned in requirements-dev.txt, so the editor reports what CI
  // reports (rules in ruff.toml). Falls back to the extension's bundled ruff.
  "ruff.importStrategy": "fromEnvironment",

  // The code isn't ruff-formatted or isort-sorted, and CI doesn't ask for either, so
  // saving a file only checks it. Formatting or sorting on save would rewrite most lines.
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "never",
      "source.organizeImports": "never"
    }
  },

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,

  "files.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".mypy_cache": true
  },
  "search.exclude": {
    "docs/images": true
  },

  // Look and feel. The theme is Aura (daltonmenezes.aura-theme) and the icons Catppuccin's
  // (catppuccin.catppuccin-vsc-icons); without them VS Code falls back to its defaults, and
  // to the next font in each list.
  "workbench.colorTheme": "Aura Dark (Soft Text)",
  "workbench.iconTheme": "catppuccin-mocha",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
  "editor.fontLigatures": "'calt', 'zero', 'ss01'",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.2,
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.renderLineHighlight": "all",
  "editor.bracketPairColorization.enabled": true,
  "workbench.activityBar.location": "top",
  "workbench.layoutControl.enabled": false,
  "breadcrumbs.icons": true,
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font Mono', 'Cascadia Mono', monospace",
  "editor.semanticHighlighting.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.padding.top": 8,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.highlightModifiedTabs": true,

  // Each analyzer is a few thousand lines split into numbered banners ("# 1. Helpers: ...")
  // and "# ------ tables" dividers inside the classes; the tests use the same dividers.
  // Label them in the minimap so it works as a table of contents.
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 100,
  "editor.minimap.showMarkSectionHeaders": true,
  "editor.minimap.markSectionHeaderRegex": "^[ \\t]*# (?:-{10,} )?(?<label>(?:\\d+\\. |(?<=- ))\\S.*)$",

  // Branch in the title bar, for when the status bar is hidden.
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${activeRepositoryBranchName}",

  // Aura's violet on the title bar, and its mint for what's active, so this window is
  // easy to pick out from other projects.
  "workbench.colorCustomizations": {
    "[Aura Dark (Soft Text)]": {
      "titleBar.activeBackground": "#2a2140",
      "titleBar.activeForeground": "#edecee",
      "titleBar.inactiveBackground": "#15141b",
      "titleBar.inactiveForeground": "#6d6d6d",
      "titleBar.border": "#a277ff55",
      "commandCenter.background": "#a277ff1f",
      "commandCenter.activeBackground": "#a277ff33",
      "commandCenter.border": "#a277ff66",
      "commandCenter.foreground": "#edecee",
      "commandCenter.activeForeground": "#ffffff",
      "activityBarTop.activeBorder": "#61ffca",
      "activityBar.activeBorder": "#61ffca",
      "tab.activeBorderTop": "#a277ff",
      "tab.activeBorder": "#00000000",
      "editorCursor.foreground": "#61ffca",
      "editor.lineHighlightBackground": "#a277ff10",
      "editor.lineHighlightBorder": "#00000000",
      "editor.selectionBackground": "#a277ff40",
      "statusBar.background": "#15141b",
      "statusBar.border": "#a277ff33",
      "statusBarItem.remoteBackground": "#a277ff",
      "statusBarItem.remoteForeground": "#15141b",
      "focusBorder": "#a277ff88",
      "scrollbarSlider.background": "#a277ff22",
      "scrollbarSlider.hoverBackground": "#a277ff44",
      "scrollbarSlider.activeBackground": "#a277ff66"
    }
  },
  "cSpell.words": [
    "AROA",
    "autostop",
    "billables",
    "boto",
    "burstable",
    "capsys",
    "Consolas",
    "couldnt",
    "cpus",
    "datascience",
    "deepagents",
    "deepseek",
    "delenv",
    "getaffinity",
    "getipython",
    "getpid",
    "hasn",
    "huggingface",
    "Inferentia",
    "Kolkata",
    "loadavg",
    "Menlo",
    "mininterval",
    "noheader",
    "nounits",
    "opensearch",
    "recordnotfound",
    "Rerank",
    "reranker",
    "Roboto",
    "Segoe",
    "smmod",
    "Stubber",
    "tkthreadd",
    "toolkits",
    "Trainium",
    "trashinfo",
    "vcpus"
  ]
}
