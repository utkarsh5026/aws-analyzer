{
  "name": "aws-analyzer-web",
  "version": "0.0.0",
  "description": "The page `aws-analyzer serve` opens: Preact and TypeScript, built into src/aws_analyzer/server/static/dist/",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
